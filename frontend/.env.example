# Copy to .env.local (gitignored) and adjust as needed. See README.md → Environment Variables.

# Set to "true" to run entirely against the in-app mock dataset (src/services/mock/) instead of a
# real backend. Off/unset by default — the app talks to the real API via the dev proxy (see
# vite.config.ts) or nginx (see nginx.conf) in production.
VITE_USE_MOCKS=false
